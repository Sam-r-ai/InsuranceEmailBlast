# Copy this file to .env and fill in your own values.
# Everything in the REQUIRED section must be set before any email is sent.

# ----- REQUIRED -----
AGENT_NAME=Your Name
# Your insurance license number. Shown next to your name in every email
# (required for CA licensees by Insurance Code 1725.5).
AGENT_LICENSE=1234567
WORK_PHONE=5555555555
WORK_EMAIL=youremail@gmail.com
# Valid physical postal address (street address, USPS-registered PO Box, or
# registered private mailbox). REQUIRED in every commercial email by CAN-SPAM.
POSTAL_ADDRESS=123 Main St Suite 4, Sacramento, CA 95814
# The part of the Google Sheet URL between /d/ and /edit
SPREADSHEET_ID=your_google_sheet_id_here

# ----- OPTIONAL (defaults shown) -----
# State whose license number is shown in the signature.
#LICENSE_STATE=CA
#AGENCY_NAME=Family First Life
# Scheduling link shown in emails. Leave unset to omit it.
#BOOKING_URL=https://calendly.com/yourname/consultation
# Tab the blast + follow-ups read leads from.
#TARGET_SHEET_NAME=Bad_Numbers_Email
# Max emails per run. Keep modest: a personal Gmail account allows ~500
# recipients per rolling 24h TOTAL, and new senders should ramp up slowly.
#DAILY_LIMIT=25
# Random wait between sends, in seconds. Evenly-spaced robotic sending is a
# spam signal; 60-180s spreads a 25-email run over ~30-75 minutes.
#DELAY_MIN_SECONDS=60
#DELAY_MAX_SECONDS=180
# Days to wait after the first email before the follow-up.
#FOLLOWUP_DAYS=4

# ----- TESTING -----
# DRY_RUN=true prints what would be sent without sending or writing anything.
#DRY_RUN=true
# Sends every email to this address instead of the leads (sheet not marked).
# Great for previewing the template in a real inbox.
#TEST_SEND_TO=youremail@gmail.com

# ----- ADVANCED -----
# Path of the Google Sheets service-account key file.
#SHEETS_SERVICE_ACCOUNT_FILE=sheet_service_account.json
# Inline images for the first-touch email. Missing files are skipped cleanly.
#BUSINESS_CARD_PATH=images/Your_Card.png
#CARRIERS_CARD_PATH=images/Carriers.png
# Bookkeeping tab names.
#INVALID_EMAIL_TAB=Invalid_Email
#UNSUBSCRIBES_TAB=Unsubscribes
#SOFT_BOUNCES_TAB=Soft_Bounces
#BOUNCE_REVIEW_TAB=Bounce_Review
